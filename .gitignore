__pycache__/
*.pyc
*.decksynth.tmp
*.dspreset.tmp

# Build output
node_modules/
ui/dist/
ui/.runtime/
decksynth/native/*.so
decksynth/native/prebuilt/
.tools/
packaging/release/dist/
packaging/flatpak/builddir/
packaging/flatpak/dist/
packaging/flatpak/repo/
.flatpak-builder/
*.flatpak
*.log

# Audio and screenshots stay local
*.wav
*.WAV
!ui/demo-kits/**/*.wav
*.png
!packaging/flatpak/*.png
artifacts/

# Private build notes never go public (they live in ~/Projects/Decksynth-private)
*.patch
AGENTS.md
NEXT_SESSION.md
PLAN.md
UI-RULES.md
*CHECKPOINT*.md
*HANDOFF*.md
.superpowers/
.impeccable/
.claude/
.codex/
ui/docs/
ui/reference/
ui/references/

# Agent notes and tooling stay private (moved to ~/Projects/Decksynth-private/agent-notes)
docs/superpowers/
.github/agents/
.github/hooks/
.github/skills/
*codex*
*Codex*
!decksynth/assets/*.wav
